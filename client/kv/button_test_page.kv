<ButtonTestPage>:
    FloatLayout:
        BoxLayout:
            orientation: "vertical"
            spacing: 12
            padding: [5, 5]
            canvas.before:
                Color:
                    rgba: 0.1, 0.1, 0.15, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Top row: LEFT, ENTER, RIGHT
            BoxLayout:
                orientation: "horizontal"
                spacing: 18
                size_hint_y: 0.33

                # LEFT button 
                BoxLayout:
                    orientation: "vertical"
                    spacing: 2
                    size_hint_x: 0.28
                    Button:
                        id: left_btn
                        size_hint_y: 0.85
                        Image:
                            source: "assets/test_arrow.png"
                            pos: self.parent.pos
                            size: self.parent.size
                            allow_stretch: True
                            keep_ratio: True
                    Label:
                        text: ""
                        font_size: "10sp"
                        size_hint_y: 0.15

                # ENTER button with label
                BoxLayout:
                    orientation: "vertical"
                    spacing: 2
                    size_hint_x: 0.28
                    Button:
                        id: enter_btn
                        size_hint_y: 0.85
                        Image:
                            source: "assets/test_enter.png"
                            pos: self.parent.pos
                            size: self.parent.size
                            allow_stretch: True
                            keep_ratio: True
                    Label:
                        text: "hold 2s to exit"
                        font_size: "10sp"
                        size_hint_y: 0.15

                # RIGHT button 
                BoxLayout:
                    orientation: "vertical"
                    spacing: 2
                    size_hint_x: 0.28
                    Button:
                        id: right_btn
                        size_hint_y: 0.85
                        Image:
                            source: "assets/test_arrow.png"
                            pos: self.parent.pos
                            size: self.parent.size
                            allow_stretch: True
                            keep_ratio: True
                            canvas.before:
                                PushMatrix:
                                Rotate:
                                    angle: 180
                                    origin: self.center
                            canvas.after:
                                PopMatrix:
                    Label:
                        text: ""
                        font_size: "10sp"
                        size_hint_y: 0.15

            # Middle row: DOWN, UP (centered)
            BoxLayout:
                orientation: "horizontal"
                spacing: 18
                size_hint_y: 0.33

                Widget:
                    size_hint_x: 0.17

                # DOWN button 
                BoxLayout:
                    orientation: "vertical"
                    spacing: 2
                    size_hint_x: 0.33
                    Button:
                        id: down_btn
                        size_hint_y: 0.85
                        Image:
                            source: "assets/test_arrow.png"
                            pos: self.parent.pos
                            size: self.parent.size
                            allow_stretch: True
                            keep_ratio: True
                            canvas.before:
                                PushMatrix:
                                Rotate:
                                    angle: 90
                                    origin: self.center
                            canvas.after:
                                PopMatrix:
                    Label:
                        text: ""
                        font_size: "10sp"
                        size_hint_y: 0.15

                # UP button 
                BoxLayout:
                    orientation: "vertical"
                    spacing: 2
                    size_hint_x: 0.33
                    Button:
                        id: up_btn
                        size_hint_y: 0.85
                        Image:
                            source: "assets/test_arrow.png"
                            pos: self.parent.pos
                            size: self.parent.size
                            allow_stretch: True
                            keep_ratio: True
                            canvas.before:
                                PushMatrix:
                                Rotate:
                                    angle: -90
                                    origin: self.center
                            canvas.after:
                                PopMatrix:
                    Label:
                        text: ""
                        font_size: "10sp"
                        size_hint_y: 0.15

                Widget:
                    size_hint_x: 0.17

            # Bottom row: CAL, BYPASS
            BoxLayout:
                orientation: "horizontal"
                spacing: 48
                size_hint_y: 0.33

                # CAL button
                BoxLayout:
                    orientation: "vertical"
                    spacing: 2
                    size_hint_x: 0.40
                    Button:
                        id: cal_btn
                        size_hint_y: 0.85
                        Image:
                            source: "assets/test_cal.png"
                            pos: self.parent.pos
                            size: self.parent.size
                            allow_stretch: True
                            keep_ratio: True
                    Label:
                        text: "bypass mode required"
                        font_size: "10sp"
                        size_hint_y: 0.15

                # BYPASS button 
                BoxLayout:
                    orientation: "vertical"
                    spacing: 2
                    size_hint_x: 0.40
                    Button:
                        id: bypass_btn
                        size_hint_y: 0.85
                        Image:
                            source: "assets/test_bypass.png"
                            pos: self.parent.pos
                            size: self.parent.size
                            allow_stretch: True
                            keep_ratio: True
                    Label:
                        text: ""
                        font_size: "10sp"
                        size_hint_y: 0.15

        ProgressBar:
            id: hold_progress_bar
            max: 100
            value: 0
            size_hint: 0.6, None
            height: 10
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            opacity: 0
