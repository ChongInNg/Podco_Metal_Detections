<SystemScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: 2
        padding: 1
        canvas.before:
            Color:
                rgba: 0.1, 0.1, 0.15, 1
            Rectangle:
                pos: self.pos
                size: self.size

        GridLayout:
            cols: 2
            rows: 4
            spacing: 5
            padding: [10, 15]
            size_hint_y: 0.85
            canvas.before:
                Color:
                    rgba: 0.15, 0.15, 0.2, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Row 1: Firmware Version
            Label:
                text: "Firmware Ver:"
                font_size: "18sp"
                size_hint_x: 0.5
                halign: "left"
                valign: "middle"
                text_size: self.size
                padding: [10, 0]
            Label:
                id: firmware_version_value_label
                text: root.firmware_version
                font_size: "18sp"
                size_hint_x: 0.5
                halign: "center"
                valign: "middle"
                text_size: self.size
                color: 0.3, 0.8, 1, 1
                bold: True

            # Row 2: Hardware Version
            Label:
                text: "Hardware Ver:"
                font_size: "18sp"
                size_hint_x: 0.5
                halign: "left"
                valign: "middle"
                text_size: self.size
                padding: [10, 0]
            Label:
                id: hardware_version_value_label
                text: root.hardware_version
                font_size: "18sp"
                size_hint_x: 0.5
                halign: "center"
                valign: "middle"
                text_size: self.size
                color: 0.3, 0.8, 1, 1
                bold: True

            # Row 3: Upgrade Button
            Label:
                text: "Upgrade:"
                font_size: "18sp"
                size_hint_x: 0.5
                halign: "left"
                valign: "middle"
                text_size: self.size
                padding: [10, 0]
            Button:
                id: upgrade_btn
                text: "Upgrade"
                size_hint_x: 0.5
                size_hint_y: 0.6
                font_size: "18sp"
                on_release: root.on_upgrade_btn_click()

            # Row 4: Rollback Button
            Label:
                text: "Rollback:"
                font_size: "18sp"
                size_hint_x: 0.5
                halign: "left"
                valign: "middle"
                text_size: self.size
                padding: [10, 0]
            Button:
                id: rollback_btn
                text: "Rollback"
                size_hint_x: 0.5
                size_hint_y: 0.6
                font_size: "18sp"
                on_release: root.on_rollback_btn_click()

        # Back button at bottom
        BoxLayout:
            orientation: "horizontal"
            spacing: 5
            padding: [10, 5]
            size_hint_y: 0.15
            Label:
                text: ""
                size_hint_x: 0.5
            Button:
                id: back_btn
                text: "Back"
                font_size: "18sp"
                size_hint_x: 0.5
                on_release: root.on_back_btn_click()
